#!/bin/zsh

export GIT_PAGER=cat
set -euo pipefail

die() {
  print -u2 -- "오류: $*"
  exit 1
}

cleanup() {
  [[ -n "${mapping_file:-}" && -f "${mapping_file:-}" ]] && rm -f "$mapping_file"
  [[ -n "${selected_file:-}" && -f "${selected_file:-}" ]] && rm -f "$selected_file"
  [[ -n "${history_file:-}" && -f "${history_file:-}" ]] && rm -f "$history_file"
}

trap cleanup EXIT INT TERM

# Git 저장소인지 확인
git rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
  die "현재 위치가 Git 저장소가 아닙니다."

# fzf 설치 여부 확인
command -v fzf >/dev/null 2>&1 ||
  die "fzf가 설치되어 있지 않습니다. 'brew install fzf'로 설치하세요."

# macOS BSD date인지 확인
command -v date >/dev/null 2>&1 ||
  die "date 명령어를 찾을 수 없습니다."

# detached HEAD 방지
branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null)" ||
  die "현재 detached HEAD 상태입니다. 브랜치로 전환한 뒤 실행하세요."

# rebase, merge 등 진행 중인지 확인
git_dir="$(git rev-parse --git-dir)"

[[ ! -d "$git_dir/rebase-merge" && ! -d "$git_dir/rebase-apply" ]] ||
  die "현재 rebase가 진행 중입니다."

[[ ! -f "$git_dir/MERGE_HEAD" ]] ||
  die "현재 merge가 진행 중입니다."

[[ ! -f "$git_dir/CHERRY_PICK_HEAD" ]] ||
  die "현재 cherry-pick이 진행 중입니다."

# 추적 중인 파일의 변경사항 확인
if ! git diff --quiet || ! git diff --cached --quiet; then
  die "작업 트리에 커밋되지 않은 변경사항이 있습니다. 먼저 commit 또는 stash 하세요."
fi

# 임시 파일
mapping_file="$(mktemp -t gmd-mapping.XXXXXX)"
selected_file="$(mktemp -t gmd-selected.XXXXXX)"
history_file="$(mktemp -t gmd-history.XXXXXX)"

# 커밋 목록 생성
#
# %H : 전체 commit hash
# %h : 축약 commit hash
# %cd: committer date
# %an: author name
# %s : subject
commit_list="$(
  git log "$branch" \
    --date=format-local:'%Y-%m-%d %H:%M:%S' \
    --format='%H%x09%h%x09%cd%x09%an%x09%s' |
    awk -F '\t' 'BEGIN { OFS="\t" } { printf "%s\t%-8s\t%-19s\t%-20s\t%s\n", $1, $2, $3, $4, $5 }'
)"

[[ -n "$commit_list" ]] ||
  die "선택할 커밋이 없습니다."

# fzf에서 여러 커밋 선택
# Tab: 선택/해제, Enter: 확정
selected="$(
  print -r -- "$commit_list" |
    fzf \
      --multi \
      --layout=reverse-list \
      --delimiter=$'\t' \
      --with-nth=2,3,4,5 \
      --nth=2,3,4,5 \
      --prompt='날짜 변경할 커밋 검색 > ' \
      --header=$'\nTab: 다중 선택/해제 | Enter: 확정\n ' \
      --preview='
        hash={1}
        git show \
          --stat \
          --decorate \
          --date=iso-local \
          --format="commit %H%nauthor:    %an <%ae>%nauthor date: %ad%ncommit:    %cn <%ce>%ncommit date: %cd%n%n%B" \
          "$hash"
      ' \
      --preview-window='down,60%,wrap'
)" || {
  print -- "선택을 취소했습니다."
  exit 0
}

[[ -n "$selected" ]] || {
  print -- "선택된 커밋이 없습니다."
  exit 0
}

# 선택된 해시만 저장
print -r -- "$selected" | cut -f1 > "$selected_file"

# 선택된 커밋이 실제로 존재하는지 확인
while IFS= read -r commit; do
  git cat-file -e "${commit}^{commit}" 2>/dev/null ||
    die "선택한 커밋을 찾을 수 없습니다: $commit"
done < "$selected_file"

# 현재 브랜치의 커밋을 오래된 순서로 저장한다.
# 선택된 커밋별 입력 순서 및 인근 5개 로그 표시에 사용한다.
git log "$branch" \
  --reverse \
  --topo-order \
  --date=format-local:'%Y-%m-%d %H:%M:%S' \
  --format='%H%x09%h%x09%cd%x09%an%x09%s' > "$history_file"

# 선택 커밋은 화면에서 최신 순서로 처리한다.
# history_file은 내부 계산을 위해 오래된 순서로 유지하되, 배열 앞에 삽입해 순서를 뒤집는다.
selected_commits=()
while IFS=$'\t' read -r full_hash short_hash commit_date author subject; do
  if grep -Fxq "$full_hash" "$selected_file"; then
    selected_commits=("$full_hash" "${selected_commits[@]}")
  fi
done < "$history_file"

(( ${#selected_commits[@]} > 0 )) ||
  die "현재 브랜치 이력에서 선택한 커밋을 찾을 수 없습니다."

show_nearby_commits() {
  local target_commit="$1"
  local target_line start_line end_line total_lines line_no
  local full_hash short_hash commit_date author subject marker

  target_line="$(awk -F '\t' -v hash="$target_commit" '$1 == hash { print NR; exit }' "$history_file")"
  [[ -n "$target_line" ]] || return 0

  total_lines="$(wc -l < "$history_file" | tr -d ' ')"
  start_line=$(( target_line - 2 ))
  end_line=$(( target_line + 2 ))

  (( start_line < 1 )) && start_line=1
  if (( end_line > total_lines )); then
    end_line=$total_lines
  fi

  # 항상 가능하면 5개가 보이도록 시작/끝 위치 보정
  if (( end_line - start_line + 1 < 5 )); then
    if (( start_line == 1 )); then
      end_line=$(( total_lines < 5 ? total_lines : 5 ))
    else
      start_line=$(( total_lines - 4 ))
      (( start_line < 1 )) && start_line=1
    fi
  fi

  print -- "인근 커밋 5개 (최신 순 → 오래된 순)"

  # 내부 이력은 오래된 순서이므로, 선택 범위만 역순으로 출력한다.
  sed -n "${start_line},${end_line}p" "$history_file" |
    awk '{ lines[NR] = $0 } END { for (i = NR; i >= 1; i--) print lines[i] }' |
    while IFS=$'\t' read -r full_hash short_hash commit_date author subject; do
      marker='  '
      [[ "$full_hash" == "$target_commit" ]] && marker='▶ '
      printf '%s%-10s  %-19s  %-20s  %s\n' "$marker" "$short_hash" "$commit_date" "$author" "$subject"
    done
}

validate_date() {
  local input_date="$1"
  local validated_date roundtrip_date

  if [[ ! "$input_date" =~ '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$' ]]; then
    return 1
  fi

  validated_date="$(
    LC_ALL=C date \
      -j \
      -f '%Y-%m-%d %H:%M:%S' \
      "$input_date" \
      '+%Y-%m-%d %H:%M:%S %z' \
      2>/dev/null
  )" || return 1

  roundtrip_date="${validated_date% *}"
  [[ "$roundtrip_date" == "$input_date" ]] || return 1

  print -r -- "$validated_date"
}

print
print -- "선택한 ${#selected_commits[@]}개 커밋의 날짜를 최신 순서대로 입력합니다."
print -- "형식: YYYY-MM-DD HH:MM:SS"
print -- "빈 값으로 Enter를 누르면 해당 커밋의 기존 날짜를 유지합니다."

index=0
for commit in "${selected_commits[@]}"; do
  (( index += 1 ))

  current_date="$(git show -s --date=format-local:'%Y-%m-%d %H:%M:%S' --format='%cd' "$commit")"
  short_hash="$(git rev-parse --short "$commit")"
  subject="$(git show -s --format='%s' "$commit")"

  while true; do
    print
    print -- "────────────────────────────────────────────────────────────"
    print -- "[$index/${#selected_commits[@]}] $short_hash  $subject"
    show_nearby_commits "$commit"
    print
    print -- "현재 날짜: $current_date"
    print -n -- "새 날짜 > "

    IFS= read -r input_date

    # 빈 값은 기존 날짜 유지
    if [[ -z "$input_date" ]]; then
      new_git_date="$(git show -s --format='%ci' "$commit")"
      break
    fi

    if new_git_date="$(validate_date "$input_date")"; then
      break
    fi

    print -u2 -- "올바르지 않은 날짜입니다. YYYY-MM-DD HH:MM:SS 형식으로 다시 입력하세요."
  done

  printf '%s\t%s\n' "$commit" "$new_git_date" >> "$mapping_file"
done

print
print -- "[변경 예정 내역]"
while IFS=$'\t' read -r commit new_date; do
  git show -s \
    --date=format-local:'%Y-%m-%d %H:%M:%S' \
    --format='  %h  기존: %cd  %s' \
    "$commit"
  print -- "            변경: $new_date"
done < "$mapping_file"

# 실제로 날짜가 달라지는 커밋만 추린다.
changed_mapping_file="${mapping_file}.changed"
: > "$changed_mapping_file"
while IFS=$'\t' read -r commit new_date; do
  current_iso="$(git show -s --format='%ci' "$commit")"
  [[ "$current_iso" == "$new_date" ]] || printf '%s\t%s\n' "$commit" "$new_date" >> "$changed_mapping_file"
done < "$mapping_file"
mv "$changed_mapping_file" "$mapping_file"

if [[ ! -s "$mapping_file" ]]; then
  print
  print -- "변경할 날짜가 없습니다. 종료합니다."
  exit 0
fi

# 가장 오래된 변경 대상 커밋을 찾는다.
oldest_changed_commit=""
while IFS=$'\t' read -r full_hash short_hash commit_date subject; do
  if awk -F '\t' -v hash="$full_hash" '$1 == hash { found=1; exit } END { exit !found }' "$mapping_file"; then
    oldest_changed_commit="$full_hash"
    break
  fi
done < "$history_file"

[[ -n "$oldest_changed_commit" ]] ||
  die "가장 오래된 변경 대상 커밋을 찾을 수 없습니다."

print
print -- "가장 오래된 변경 대상 커밋부터 현재 브랜치 HEAD까지 SHA가 변경됩니다."

while true; do
  print -n -- "계속하시겠습니까? [y/n]: "
  IFS= read -r confirmation

  case "$confirmation" in
    [Yy])
      break
      ;;
    [Nn])
      print -- "취소했습니다."
      exit 0
      ;;
    *)
      print -u2 -- "올바른 값이 아닙니다. y 또는 n을 입력하세요."
      ;;
  esac
done

# 원본 브랜치 백업
backup_name="gmd-backup/${branch//\//-}-$(date '+%Y%m%d-%H%M%S')"
git branch "$backup_name" "$branch"

print
print -- "백업 브랜치를 생성했습니다: $backup_name"

# filter-branch에 전달할 환경 변수
export GMD_MAPPING_FILE="$mapping_file"
export FILTER_BRANCH_SQUELCH_WARNING=1

# 가장 오래된 변경 대상부터 HEAD까지만 다시 작성한다.
# 브랜치 이름을 양의 revision으로 직접 전달해야 해당 브랜치 ref가 갱신된다.
filter_env='
  new_date=$(awk -F "\t" -v hash="$GIT_COMMIT" '\''$1 == hash { print $2; exit }'\'' "$GMD_MAPPING_FILE")
  if [ -n "$new_date" ]; then
    export GIT_AUTHOR_DATE="$new_date"
    export GIT_COMMITTER_DATE="$new_date"
  fi
'

if git rev-parse "${oldest_changed_commit}^" >/dev/null 2>&1; then
  git filter-branch \
    --force \
    --env-filter "$filter_env" \
    -- "$branch" "^${oldest_changed_commit}^"
else
  git filter-branch \
    --force \
    --env-filter "$filter_env" \
    -- "$branch"
fi

unset GMD_MAPPING_FILE
unset FILTER_BRANCH_SQUELCH_WARNING

print
print -- "날짜 변경이 완료되었습니다."
print -- "원본 백업 브랜치: $backup_name"
print
print -- "최근 커밋:"
git log \
  -n 10 \
  --date=iso-local \
  --format='%C(auto)%h%Creset  %cd  %s'
